# ─────────────────────────────────────────────────────────────────────────────
# API Sentinel — Environment Variables Example
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=False

# ── Database ─────────────────────────────────────────────────────────────────
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# Production (PostgreSQL — use with docker-compose):
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@postgres/sentinel

# ── Security ─────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production!
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sentinel-super-secret-key-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# Development: allow all
CORS_ORIGINS=["*"]
# Production: restrict to your frontend domain
# CORS_ORIGINS=["https://yourdomain.com"]

# ── Enforcement ──────────────────────────────────────────────────────────────
# True  = Block threats with HTTP 403 (production)
# False = Alert only, no blocking (learning/passive mode)
ENFORCEMENT_MODE=True

# ── Detection Thresholds ─────────────────────────────────────────────────────
ANOMALY_SCORE_THRESHOLD=60.0
ENUM_WINDOW_SECONDS=60
ENUM_THRESHOLD=5

# ── Risk Score Weights ───────────────────────────────────────────────────────
W_OWNERSHIP_MISMATCH=50.0
W_ENUMERATION_SIGNAL=25.0
W_ROLE_MISMATCH=20.0
W_ENDPOINT_NOVELTY=40.0
W_SENSITIVE_DATA_SIGNAL=30.0
W_ADMIN_FUNCTION_SIGNAL=30.0

# ── Event Store ──────────────────────────────────────────────────────────────
MAX_EVENTS_IN_MEMORY=10000
MAX_ALERTS_IN_MEMORY=1000

# ── Kafka (production only, used with docker-compose) ────────────────────────
# KAFKA_BROKERS=kafka:9092

# ── Redis (production only, used with docker-compose) ────────────────────────
# REDIS_URL=redis://redis:6379/0
